{
  "name": "big-cat-motors-edge",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://big-cat-motors-prod.vercel.app",
    "BUILD_SHA": "preview"
  },
  "queues": {
    "producers": [{ "queue": "bigcat-lead-events", "binding": "LEAD_QUEUE" }],
    "consumers": [{ "queue": "bigcat-lead-events", "max_batch_size": 10, "max_batch_timeout": 5 }]
  },
  "r2_buckets": [{ "binding": "BIGCAT_MEDIA", "bucket_name": "big-cat-motors-media" }],
  "observability": { "enabled": true }
}
