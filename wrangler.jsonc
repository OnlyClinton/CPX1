{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wdcc-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "WDCC_RUNTIME_ROLE": "canonical",
    "WDCC_STATE_PROVIDER": "r2",
    "WDCC_MEDIA_PROVIDER": "r2"
  },
  "r2_buckets": [
    {
      "binding": "WDCC_DATA",
      "bucket_name": "wdcc-platform-prod"
    }
  ]
}
